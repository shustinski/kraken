(edif SYNTHETIC_EXPLICIT_DFF
 (library PRIMITIVES
  (cell PMOS (view SYMBOL (viewType NETLIST) (interface (port GATE (direction INPUT)) (port SOURCE (direction INOUT)) (port DRAIN (direction INOUT)))))
  (cell NMOS (view SYMBOL (viewType NETLIST) (interface (port GATE (direction INPUT)) (port SOURCE (direction INOUT)) (port DRAIN (direction INOUT)))))
 )
 (library CIRCUITS (cell FF (view NETLIST (viewType NETLIST)
 (interface (port CLK (direction INPUT))(port D (direction INPUT))(port Q (direction OUTPUT))(port VDD (direction INOUT))(port GND (direction INOUT)))
 (contents
 (instance PCLK (viewRef SYMBOL (cellRef PMOS (libraryRef PRIMITIVES))))
 (instance NCLK (viewRef SYMBOL (cellRef NMOS (libraryRef PRIMITIVES))))
 (instance MP1 (viewRef SYMBOL (cellRef PMOS (libraryRef PRIMITIVES))))
 (instance MN1 (viewRef SYMBOL (cellRef NMOS (libraryRef PRIMITIVES))))
 (instance MP2 (viewRef SYMBOL (cellRef PMOS (libraryRef PRIMITIVES))))
 (instance MN2 (viewRef SYMBOL (cellRef NMOS (libraryRef PRIMITIVES))))
 (instance MP3 (viewRef SYMBOL (cellRef PMOS (libraryRef PRIMITIVES))))
 (instance MN3 (viewRef SYMBOL (cellRef NMOS (libraryRef PRIMITIVES))))
 (instance MP4 (viewRef SYMBOL (cellRef PMOS (libraryRef PRIMITIVES))))
 (instance MN4 (viewRef SYMBOL (cellRef NMOS (libraryRef PRIMITIVES))))
 (instance SP1 (viewRef SYMBOL (cellRef PMOS (libraryRef PRIMITIVES))))
 (instance SN1 (viewRef SYMBOL (cellRef NMOS (libraryRef PRIMITIVES))))
 (instance SP2 (viewRef SYMBOL (cellRef PMOS (libraryRef PRIMITIVES))))
 (instance SN2 (viewRef SYMBOL (cellRef NMOS (libraryRef PRIMITIVES))))
 (instance SP3 (viewRef SYMBOL (cellRef PMOS (libraryRef PRIMITIVES))))
 (instance SN3 (viewRef SYMBOL (cellRef NMOS (libraryRef PRIMITIVES))))
 (instance SP4 (viewRef SYMBOL (cellRef PMOS (libraryRef PRIMITIVES))))
 (instance SN4 (viewRef SYMBOL (cellRef NMOS (libraryRef PRIMITIVES))))
 (net CLK (joined (portRef GATE (instanceRef PCLK)) (portRef GATE (instanceRef NCLK)) (portRef GATE (instanceRef MP3)) (portRef GATE (instanceRef MN4)) (portRef GATE (instanceRef SN3)) (portRef GATE (instanceRef SP4)) (portRef CLK)))
 (net VDD (joined (portRef SOURCE (instanceRef PCLK)) (portRef SOURCE (instanceRef MP1)) (portRef SOURCE (instanceRef MP2)) (portRef SOURCE (instanceRef SP1)) (portRef SOURCE (instanceRef SP2)) (portRef VDD)))
 (net CLKB (joined (portRef DRAIN (instanceRef PCLK)) (portRef DRAIN (instanceRef NCLK)) (portRef GATE (instanceRef MN3)) (portRef GATE (instanceRef MP4)) (portRef GATE (instanceRef SP3)) (portRef GATE (instanceRef SN4))))
 (net GND (joined (portRef SOURCE (instanceRef NCLK)) (portRef SOURCE (instanceRef MN1)) (portRef SOURCE (instanceRef MN2)) (portRef SOURCE (instanceRef SN1)) (portRef SOURCE (instanceRef SN2)) (portRef GND)))
 (net M_A (joined (portRef GATE (instanceRef MP1)) (portRef GATE (instanceRef MN1)) (portRef DRAIN (instanceRef MP2)) (portRef DRAIN (instanceRef MN2)) (portRef DRAIN (instanceRef MP3)) (portRef DRAIN (instanceRef MN3)) (portRef DRAIN (instanceRef MP4)) (portRef DRAIN (instanceRef MN4))))
 (net M_B (joined (portRef DRAIN (instanceRef MP1)) (portRef DRAIN (instanceRef MN1)) (portRef GATE (instanceRef MP2)) (portRef GATE (instanceRef MN2)) (portRef SOURCE (instanceRef MP4)) (portRef SOURCE (instanceRef MN4)) (portRef SOURCE (instanceRef SP3)) (portRef SOURCE (instanceRef SN3))))
 (net D (joined (portRef SOURCE (instanceRef MP3)) (portRef SOURCE (instanceRef MN3)) (portRef D)))
 (net S_A (joined (portRef GATE (instanceRef SP1)) (portRef GATE (instanceRef SN1)) (portRef DRAIN (instanceRef SP2)) (portRef DRAIN (instanceRef SN2)) (portRef DRAIN (instanceRef SP3)) (portRef DRAIN (instanceRef SN3)) (portRef DRAIN (instanceRef SP4)) (portRef DRAIN (instanceRef SN4))))
 (net S_B (joined (portRef DRAIN (instanceRef SP1)) (portRef DRAIN (instanceRef SN1)) (portRef GATE (instanceRef SP2)) (portRef GATE (instanceRef SN2)) (portRef SOURCE (instanceRef SP4)) (portRef SOURCE (instanceRef SN4)) (portRef Q)))
 ))))
 (design SYNTHETIC_EXPLICIT_DFF (cellRef FF (libraryRef CIRCUITS))))
