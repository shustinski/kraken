{
  "plugins": [
    {
      "id": "neuralimage",
      "display_name": "NeuralImage",
      "description": "Neural IC image segmentation, training, and recognition.",
      "version": "6.3.0",
      "protocol_version": "1.0",
      "enabled": true,
      "platforms": ["windows", "linux"],
      "executables": {
        "windows": {"command": ["python", "__main__.py"]},
        "linux": {"command": ["python", "__main__.py"]}
      },
      "actions": ["get_capabilities", "open_path", "open_folder", "run_action"],
      "deprecated_actions": ["open_path", "open_folder", "run_action"],
      "capabilities": [
        {
          "operation": "frames.binary-segment.v1",
          "modes": ["interactive", "headless"],
          "input_media_types": ["image/png", "image/tiff", "image/jpeg"],
          "output_media_types": ["image/png"],
          "maximum_batch_size": 10000
        }
      ]
    },
    {
      "id": "contour",
      "display_name": "Contour",
      "description": "Polygon extraction and editing.",
      "version": "0.9.0",
      "protocol_version": "1.0",
      "enabled": true,
      "platforms": ["windows", "linux"],
      "executables": {
        "windows": {"command": ["python", "__main__.py"]},
        "linux": {"command": ["python", "__main__.py"]}
      },
      "actions": ["get_capabilities", "open_path", "open_folder", "run_action"],
      "deprecated_actions": ["open_path", "open_folder", "run_action"],
      "capabilities": [
        {
          "operation": "frames.vectorize.v1",
          "modes": ["interactive"],
          "input_media_types": ["image/png", "image/tiff", "image/jpeg"],
          "output_media_types": ["application/x-cif"],
          "maximum_batch_size": 10000
        }
      ]
    },
    {
      "id": "krona",
      "display_name": "Krona",
      "description": "EDIF and netlist viewer.",
      "version": "0.1.0",
      "enabled": true,
      "platforms": ["windows", "linux"],
      "executables": {
        "windows": {"command": ["python", "__main__.py"]},
        "linux": {"command": ["python", "__main__.py"]}
      },
      "actions": ["get_capabilities", "open_path", "open_folder", "run_action"]
    },
    {
      "id": "csliser",
      "display_name": "CSliser",
      "description": "Frame-based file copy, move, and cleanup tool.",
      "version": "1.0.0",
      "category": "File Tools",
      "icon": "resources/icons/csliser.png",
      "entry_point": "csliser.application.cli:main",
      "enabled": true,
      "platforms": ["windows", "linux"],
      "executables": {
        "windows": {"command": ["python", "__main__.py"]},
        "linux": {"command": ["python", "__main__.py"]}
      },
      "actions": ["get_capabilities", "open_path", "open_folder", "run_action"]
    },
    {
      "id": "kategb",
      "display_name": "KateGB",
      "description": "Формирование CIF-выборок и расчет результатов проверки.",
      "version": "1.0.0",
      "category": "Контроль качества",
      "icon": "resources/icons/kategb.png",
      "entry_point": "kategb.application.cli:main",
      "enabled": true,
      "platforms": ["windows", "linux"],
      "executables": {
        "windows": {"command": ["python", "__main__.py"]},
        "linux": {"command": ["python", "__main__.py"]}
      },
      "actions": ["get_capabilities", "open_path", "open_folder", "run_action"]
    },
    {
      "id": "karakal",
      "display_name": "Karakal",
      "description": "Validation gradient matrix viewer and metrics explorer.",
      "version": "1.0.0",
      "protocol_version": "1.0",
      "analysis_protocol_version": "1.0",
      "analysis_capabilities": [
        {"profile": "model_comparison", "required_roles": ["model_output", "model_output"], "optional_roles": ["original", "confidence"], "modes": ["interactive", "headless"]},
        {"profile": "confidence_audit", "required_roles": ["model_output", "confidence"], "optional_roles": ["original"], "modes": ["interactive"]},
        {"profile": "grid_defects", "required_roles": [], "required_any_role_groups": [["original", "model_output"]], "optional_roles": ["reference", "confidence"], "modes": ["interactive"]}
      ],
      "enabled": true,
      "platforms": ["windows", "linux"],
      "executables": {
        "windows": {"command": ["python", "__main__.py"]},
        "linux": {"command": ["python", "__main__.py"]}
      },
      "actions": ["get_capabilities", "open_path", "open_folder", "run_action"]
    }
  ]
}
