# Переменные рабочей станции Desktop / Kraken Hub.
# Скопируйте в окружение терминала или в настройки запуска. Файл не читается автоматически.
#
# Без этих переменных локальные проекты на диске продолжают работать.
# С ними диалог создания проекта предлагает PostgreSQL на Kraken Server.

KRAKEN_SERVER_URL=http://127.0.0.1:8080
KRAKEN_GITLAB_ISSUER=https://gitlab.example.com
KRAKEN_GITLAB_TOKEN=

# Необязательный манифест обновления Hub.
# KRAKEN_UPDATE_URL=https://example.org/kraken/version.json

# Каталог локальных учётных записей Desktop (команда kraken-admin bootstrap-local).
# KRAKEN_DATA_DIR=%USERPROFILE%\.kraken
