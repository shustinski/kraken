# Optional local Karakal runtime settings.
# Copy to a local .env only if your launcher loads env files.
# Do not commit real local paths, datasets, or debug output.

# Override the default cache directory. Leave empty to use the platform default.
KARAKAL_CACHE_DIR=

# Export parallelism. Empty means automatic.
KARAKAL_EXPORT_WORKERS=

# Grid inspection execution mode: process, thread, or sequential.
KARAKAL_GRID_INSPECTION_EXECUTION=process

# Grid inspection worker/process settings.
KARAKAL_GRID_INSPECTION_WORKERS=2
KARAKAL_GRID_INSPECTION_CHUNK_SIZE=8
KARAKAL_GRID_INSPECTION_OPENCV_THREADS=1
KARAKAL_GRID_INSPECTION_FRAME_TIMEOUT=20

# Optional debug output directory for grid inspection. Leave empty unless debugging.
KARAKAL_GRID_DEBUG_DIR=
